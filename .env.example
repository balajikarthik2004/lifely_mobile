# Optional. Leave it unset in development and the app works out which address to
# use: localhost on web and the iOS simulator, 10.0.2.2 on the Android emulator,
# and Metro's LAN address on a physical device in Expo Go. See src/api/config.ts.
#
# Set it once the server is deployed, or to point at a machine the automatic
# choice cannot find.
#
# EXPO_PUBLIC_API_URL=https://api.example.com
